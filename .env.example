# Server Configuration
PORT=3000
NODE_ENV=production
SESSION_SECRET=your-secure-random-session-secret

# Squad Payment Gateway (HabariPay / GTCO)
# Sandbox Base URL: https://api-d.squadco.com | Production: https://api.squadco.com
SQUAD_BASE_URL=https://api-d.squadco.com
SQUAD_SECRET_KEY=sandbox_sk_your_squad_secret_key_here

# Relaybase Email Validation
RELAYBASE_API_KEY=your_relaybase_api_key

# Email Delivery (SMTP / Nodemailer)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@yourdomain.com
